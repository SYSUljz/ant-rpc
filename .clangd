# Clangd Language Server Configuration
CompileFlags:
  CompilationDatabase: "build"
  Add:
    - "-std=c++20"
    - "-Iinclude"
    - "-I3rd_party"

Diagnostics:
  # Disable include-cleaner noise
  UnusedIncludes: None
  MissingIncludes: None
  ClangTidy:
    Add:
      - "*"
    Remove:
      - "llvmlibc-*"
      - "fuchsia-*"
      - "zircon-*"
      - "android-*"
      - "altera-*"

InlayHints:
  Designators: Yes
  Enabled: Yes
  ParameterNames: Yes
  DeducedTypes: Yes

Index:
  Background: Build